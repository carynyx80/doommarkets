# Backend REST API (GET /tokens, /tokens/:id, /stats, /creators). Mock data used if unset/unreachable.
NEXT_PUBLIC_API_URL=
# WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=
# Deployed contract addresses (leave blank until contracts are deployed)
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=
NEXT_PUBLIC_BNB_USD=900
# Optional: 56 (BSC mainnet, default) or 97 (BSC testnet)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=56
