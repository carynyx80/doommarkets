# HTTP
PORT=8080

# Chain: 56 = BSC mainnet (default), 97 = BSC testnet
CHAIN_ID=56
# Defaults: 56 -> https://bsc-dataseed.bnbchain.org, 97 -> https://bsc-testnet-dataseed.bnbchain.org
RPC_URL=https://bsc-dataseed.bnbchain.org
# eth_getLogs endpoint. bsc-dataseed rejects getLogs, so when RPC_URL is a dataseed node this
# defaults to https://bsc-rpc.publicnode.com (97: https://bsc-testnet-rpc.publicnode.com). Otherwise = RPC_URL.
LOGS_RPC_URL=
# Revealed.side value that means SURVIVE (anything else = DOOM)
SURVIVE_SIDE=1

# DoomLaunchpad contract. Leave empty to serve DEMO data (responses carry "demo": true).
LAUNCHPAD_ADDRESS=
# Block the contract was deployed at (backfill starts here). Defaults to head - 50000 if unset.
START_BLOCK=

# Optional tuning
LOG_CHUNK_SIZE=5000
POLL_INTERVAL_MS=3000
# Token total supply in whole tokens, used for mcap = price * supply
TOKEN_TOTAL_SUPPLY=1000000000

# Image uploads (POST /upload, GET /uploads/:file)
# Defaults to /data/uploads when a volume is mounted at /data, else ./uploads
UPLOAD_DIR=
# Base URL used in returned upload URLs. Falls back to https://$RAILWAY_PUBLIC_DOMAIN, then the request host.
PUBLIC_URL=
